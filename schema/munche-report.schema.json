{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ongsi2/munchekit/v0.2.0/schema/munche-report.schema.json",
  "title": "MuncheKit JSON report",
  "description": "Machine-readable output produced by `munche lint|check --output json` in MuncheKit 0.2.x.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "offsetEncoding", "reports", "summary"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "offsetEncoding": { "const": "utf-16" },
    "reports": {
      "type": "array",
      "items": { "$ref": "#/$defs/analysisReport" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column", "offset"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 0 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      }
    },
    "textEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "replacement", "safety"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "replacement": { "type": "string" },
        "safety": { "enum": ["safe", "review"] }
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "risk"],
      "properties": {
        "replacement": { "type": "string" },
        "message": { "type": "string" },
        "risk": { "enum": ["low", "medium", "high"] }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "category",
        "severity",
        "message",
        "rationale",
        "confidence",
        "fixability",
        "range",
        "location",
        "excerpt",
        "suggestions"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^KO-[A-Z]+-[0-9]{3}$"
        },
        "category": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "rationale": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "fixability": { "enum": ["safe", "review", "none"] },
        "range": { "$ref": "#/$defs/range" },
        "location": { "$ref": "#/$defs/location" },
        "excerpt": { "type": "string" },
        "suggestions": {
          "type": "array",
          "items": { "$ref": "#/$defs/suggestion" }
        },
        "fix": { "$ref": "#/$defs/textEdit" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "warning", "info", "fixable"],
      "properties": {
        "error": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "fixable": { "type": "integer", "minimum": 0 }
      }
    },
    "analysisReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "engineVersion",
        "offsetEncoding",
        "format",
        "profile",
        "diagnostics",
        "summary"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "engineVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "offsetEncoding": { "const": "utf-16" },
        "filePath": { "type": "string" },
        "format": {
          "enum": ["plain", "markdown", "mdx", "json", "html", "tsx"]
        },
        "profile": { "type": "string", "minLength": 1 },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "summary": { "$ref": "#/$defs/summary" }
      }
    }
  }
}
