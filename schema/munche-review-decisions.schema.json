{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ongsi2/munchekit/main/schema/munche-review-decisions.schema.json",
  "title": "MuncheKit review decision document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceHash", "sessionHash", "resolutions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "sourceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sessionHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "resolutions": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "decision"],
        "properties": {
          "itemId": { "type": "string", "pattern": "^review_[a-f0-9]{24}$" },
          "decision": { "enum": ["accepted", "edited", "rejected", "kept"] },
          "proposalIndex": { "type": "integer", "minimum": 0 },
          "after": { "type": "string", "maxLength": 100000 },
          "reasonTags": {
            "type": "array",
            "maxItems": 200,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 100 }
          },
          "lockedClaims": {
            "type": "array",
            "maxItems": 200,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "decision": { "const": "edited" } }, "required": ["decision"] },
            "then": { "required": ["after"] },
            "else": { "not": { "required": ["after"] } }
          }
        ]
      }
    }
  }
}
